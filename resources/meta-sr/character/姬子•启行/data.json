  "cons": {
    "1": {
      "name": "我们称之为路的，是开拓",
      "desc": "天赋额外发动<u>助战技</u>效果的次数额外增加<nobr>1</nobr>次。【同行协议：裁决】状态下，发动<u>助战技</u>所需的终结技施放次数减少<nobr>1</nobr>次。【同行协议：歼破】状态下，发动<u>助战技</u>所需的充能减少<nobr>3</nobr>点。姬子•启行发动<u>助战技</u>时，造成额外伤害的效果次数增加<nobr>1</nobr>次。"
    },
    "2": {
      "name": "旗帜，永不降下的帆",
      "desc": "姬子•启行<u>助战技</u>的使用上限提高至2次，终结技和<u>助战技</u>造成的伤害为原伤害的<nobr>130%</nobr>。【领航旗语】状态下每个回合开始时，立即额外恢复1次<u>助战技</u>使用次数。行迹【列车的脉搏在轰鸣】效果非<u>开拓同行</u>角色使用<u>助战技</u>时，也会获得1个<u>额外回合</u>。"
    },
    "3": {
      "name": "星辰之子，也在思索繁星",
      "desc": "终结技等级+2，最多不超过<nobr>15</nobr>级；普攻等级+1，最多不超过<nobr>10</nobr>级。"
    },
    "4": {
      "name": "握住所有伸向天空的手",
      "desc": "天赋【共赴灼热的远征】使用<u>助战技</u>时，全属性抗性穿透提高效果对我方全体生效，姬子•启行获得该效果时全属性抗性穿透额外提高<nobr>10%</nobr>。"
    },
    "5": {
      "name": "去跨越宇宙的全境",
      "desc": "战技等级+2，最多不超过<nobr>15</nobr>级；天赋等级+2，最多不超过<nobr>15</nobr>级。"
    },
    "6": {
      "name": "铭记，终抵群星的誓约",
